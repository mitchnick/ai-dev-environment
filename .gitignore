# Never publish local credentials or runtime state
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*credentials*
*secrets*
*token*
*auth.json

# Written into a mod folder whenever Herdr or `herdr-app check` loads it
herdr-app/home/mods/*/gpui-kit.d.ts
herdr-app/home/mods/*/jsconfig.json

# Runtime output
*.log
.DS_Store
node_modules/
target/
__pycache__/
*.pyc
coverage/
dist/
/tmp/codex-rule-context/
