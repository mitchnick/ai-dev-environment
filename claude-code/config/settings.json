{
  "env": {
    "CLAUDE_CODE_DISABLE_TERMINAL_TITLE": "1",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_CODE_ENABLE_TELEMETRY": "1",
    "OTEL_METRICS_EXPORTER": "otlp",
    "OTEL_EXPORTER_OTLP_PROTOCOL": "http/json",
    "OTEL_EXPORTER_OTLP_ENDPOINT": "http://127.0.0.1:1738"
  },
  "permissions": {
    "allow": [
      "WebFetch",
      "WebSearch",
      "Read(~/Projects/cribbage/**)",
      "Bash(langsmith:*)"
    ],
    "deny": [
      "Read(.envrc)",
      "Read(./.envrc)",
      "Read(**/.envrc)",
      "Edit(.envrc)",
      "Edit(./.envrc)",
      "Edit(**/.envrc)",
      "Bash(cat .envrc*)",
      "Bash(cat ./.envrc*)",
      "Bash(head .envrc*)",
      "Bash(head ./.envrc*)",
      "Bash(tail .envrc*)",
      "Bash(tail ./.envrc*)",
      "Bash(less .envrc*)",
      "Bash(less ./.envrc*)",
      "Bash(more .envrc*)",
      "Bash(more ./.envrc*)",
      "Bash(bat .envrc*)",
      "Bash(bat ./.envrc*)",
      "Bash(nl .envrc*)",
      "Bash(nl ./.envrc*)",
      "Bash(xxd .envrc*)",
      "Bash(xxd ./.envrc*)",
      "Bash(od .envrc*)",
      "Bash(od ./.envrc*)",
      "Bash(strings .envrc*)",
      "Bash(strings ./.envrc*)",
      "Bash(hexdump .envrc*)",
      "Bash(hexdump ./.envrc*)",
      "Bash(source .envrc*)",
      "Bash(source ./.envrc*)",
      "Bash(. .envrc*)",
      "Bash(. ./.envrc*)",
      "Bash(vim .envrc*)",
      "Bash(vim ./.envrc*)",
      "Bash(vi .envrc*)",
      "Bash(vi ./.envrc*)",
      "Bash(nano .envrc*)",
      "Bash(nano ./.envrc*)",
      "Bash(emacs .envrc*)",
      "Bash(emacs ./.envrc*)",
      "Bash(open .envrc*)",
      "Bash(open ./.envrc*)",
      "Bash(code .envrc*)",
      "Bash(code ./.envrc*)",
      "Bash(cp .envrc*)",
      "Bash(cp ./.envrc*)",
      "Bash(mv .envrc*)",
      "Bash(mv ./.envrc*)",
      "Bash(file .envrc*)",
      "Bash(file ./.envrc*)",
      "Bash(stat .envrc*)",
      "Bash(stat ./.envrc*)",
      "Bash(wc .envrc*)",
      "Bash(wc ./.envrc*)",
      "Bash(md5 .envrc*)",
      "Bash(md5 ./.envrc*)",
      "Bash(shasum .envrc*)",
      "Bash(sha256sum .envrc*)",
      "Bash(direnv export*)",
      "Bash(direnv exec*)",
      "Bash(direnv show*)",
      "Bash(direnv dump*)",
      "Bash(direnv status*)"
    ],
    "defaultMode": "auto"
  },
  "model": "opus[1m]",
  "disableRemoteControl": true,
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline-command.sh"
  },
  "enabledPlugins": {
    "gitkraken-hooks@gitkraken": true,
    "swift-lsp@claude-plugins-official": true,
    "telegram@claude-plugins-official": false
  },
  "effortLevel": "xhigh",
  "modelSettings": {
    "claude-fable-5": {
      "effortLevel": "medium"
    }
  },
  "tui": "fullscreen",
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "theme": "dark",
  "teammateMode": "in-process",
  "remoteControlAtStartup": false,
  "skipAutoPermissionPrompt": true
}
