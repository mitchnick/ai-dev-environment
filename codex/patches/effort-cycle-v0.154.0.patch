+use super::*;
+use pretty_assertions::assert_eq;
+
+#[tokio::test]
+async fn reasoning_cycle_includes_advanced_levels_wraps_and_preserves_draft() {
+    for key in [
+        KeyEvent::new(KeyCode::Char('e'), KeyModifiers::ALT | KeyModifiers::SHIFT),
+        KeyEvent::new(KeyCode::Char('E'), KeyModifiers::ALT),
+        KeyEvent::new(
+            KeyCode::Char('e'),
+            KeyModifiers::SUPER | KeyModifiers::SHIFT,
+        ),
+    ] {
+        let (mut chat, mut rx, _op_rx) = make_chatwidget_manual(Some("gpt-5.4")).await;
+        chat.thread_id = Some(ThreadId::new());
+        let mut preset = get_available_model(&chat, "gpt-5.4");
+        let levels = vec![
+            ReasoningEffortConfig::Low,
+            ReasoningEffortConfig::Medium,
+            ReasoningEffortConfig::High,
+            ReasoningEffortConfig::XHigh,
+            ReasoningEffortConfig::Max,
+            ReasoningEffortConfig::Ultra,
+        ];
+        preset.supported_reasoning_efforts = levels
+            .iter()
+            .map(|effort| ReasoningEffortPreset {
+                effort: effort.clone(),
+                description: String::new(),
+            })
+            .collect();
+        chat.model_catalog = std::sync::Arc::new(ModelCatalog::new(vec![preset]));
+        let draft = "keep this draft 🌴\nsecond line";
+        chat.bottom_pane
+            .set_composer_text(draft.into(), Vec::new(), Vec::new());
+        chat.handle_key_event(KeyEvent::new(KeyCode::Left, KeyModifiers::NONE));
+        let cursor = chat.bottom_pane.composer_cursor();
+        let _ = drain_insert_history(&mut rx);
+        for (index, current) in levels.iter().enumerate() {
+            chat.set_reasoning_effort(Some(current.clone()));
+            chat.handle_key_event(key);
+            let events = std::iter::from_fn(|| rx.try_recv().ok()).collect::<Vec<_>>();
+            let efforts: Vec<_> = events
+                .iter()
+                .filter_map(|event| match event {
+                    AppEvent::UpdateReasoningEffort(effort) => Some(effort.clone()),
+                    _ => None,
+                })
+                .collect();
+            assert_eq!(
+                efforts,
+                vec![Some(levels[(index + 1) % levels.len()].clone())]
+            );
+            assert!(events.iter().all(|event| !matches!(
+                event,
+                AppEvent::UpdateModel(_)
+                    | AppEvent::PersistModelSelection { .. }
+                    | AppEvent::PersistPlanModeReasoningEffort(_)
+            )));
+            assert_eq!(chat.bottom_pane.composer_text(), draft);
+            assert_eq!(chat.bottom_pane.composer_cursor(), cursor);
+            assert_eq!(chat.current_model(), "gpt-5.4");
+        }
+    }
+}
+
+#[tokio::test]
+async fn reasoning_cycle_respects_modal_and_key_release() {
+    let (mut chat, mut rx, _op_rx) = make_chatwidget_manual(Some("gpt-5.4")).await;
+    chat.thread_id = Some(ThreadId::new());
+    chat.set_reasoning_effort(Some(ReasoningEffortConfig::Medium));
+    let mut key = KeyEvent::new(KeyCode::Char('E'), KeyModifiers::ALT);
+    key.kind = KeyEventKind::Release;
+    chat.handle_key_event(key);
+    chat.open_model_popup();
+    key.kind = KeyEventKind::Press;
+    chat.handle_key_event(key);
+    let events = std::iter::from_fn(|| rx.try_recv().ok()).collect::<Vec<_>>();
+    assert!(events.iter().all(|event| !matches!(
+        event,
+        AppEvent::UpdateReasoningEffort(_)
+            | AppEvent::UpdateModel(_)
+            | AppEvent::PersistModelSelection { .. }
+    )));
+    assert_eq!(
+        chat.effective_reasoning_effort(),
+        Some(ReasoningEffortConfig::Medium)
+    );
+}
+
+#[tokio::test]
+async fn reasoning_cycle_single_choice_is_noop() {
+    let (mut chat, mut rx, _op_rx) = make_chatwidget_manual(Some("gpt-5.4")).await;
+    chat.thread_id = Some(ThreadId::new());
+    let mut preset = get_available_model(&chat, "gpt-5.4");
+    preset.supported_reasoning_efforts = vec![ReasoningEffortPreset {
+        effort: ReasoningEffortConfig::High,
+        description: String::new(),
+    }];
+    chat.model_catalog = std::sync::Arc::new(ModelCatalog::new(vec![preset]));
+    chat.set_reasoning_effort(Some(ReasoningEffortConfig::High));
+    let _ = drain_insert_history(&mut rx);
+    chat.handle_key_event(KeyEvent::new(KeyCode::Char('E'), KeyModifiers::ALT));
+    let text = drain_insert_history(&mut rx)
+        .into_iter()
+        .flatten()
+        .map(|line| line.to_string())
+        .collect::<Vec<_>>()
+        .join("\n");
+    assert_chatwidget_snapshot!("reasoning_cycle_single_choice", text);
+    assert_eq!(
+        chat.effective_reasoning_effort(),
+        Some(ReasoningEffortConfig::High)
+    );
+}
