+#[tokio::test]
+async fn reasoning_cycle_in_plan_mode_only_updates_plan_effort() {
+    let (mut chat, mut rx, _op_rx) = make_chatwidget_manual(Some("gpt-5.4")).await;
+    chat.thread_id = Some(ThreadId::new());
+    chat.set_feature_enabled(Feature::CollaborationModes, /*enabled*/ true);
+    let plan_mask = collaboration_modes::plan_mask(chat.model_catalog.as_ref()).expect("plan mode");
+    chat.set_collaboration_mask(plan_mask);
+    let _ = drain_insert_history(&mut rx);
+    chat.handle_key_event(KeyEvent::new(KeyCode::Char('E'), KeyModifiers::ALT));
+    let events = std::iter::from_fn(|| rx.try_recv().ok()).collect::<Vec<_>>();
+    assert_eq!(
+        events
+            .iter()
+            .filter(|event| matches!(event, AppEvent::UpdatePlanModeReasoningEffort(Some(_))))
+            .count(),
+        1
+    );
+    assert!(events.iter().all(|event| !matches!(
+        event,
+        AppEvent::UpdateReasoningEffort(_)
+            | AppEvent::UpdateModel(_)
+            | AppEvent::PersistModelSelection { .. }
+            | AppEvent::PersistPlanModeReasoningEffort(_)
+            | AppEvent::OpenPlanReasoningScopePrompt { .. }
+    )));
+}
