diff --git a/codex-rs/tui/src/chatwidget/tests/personal_shortcuts.rs b/codex-rs/tui/src/chatwidget/tests/personal_shortcuts.rs
new file mode 100644
index 000000000..53403c6ab
--- /dev/null
+++ b/codex-rs/tui/src/chatwidget/tests/personal_shortcuts.rs
@@ -0,0 +1,144 @@
+use super::*;
+
+#[tokio::test]
+async fn model_shortcuts_open_picker_without_consuming_draft() {
+    for modifiers in [KeyModifiers::SUPER, KeyModifiers::ALT] {
+        let (mut chat, _rx, _ops) = make_chatwidget_manual(/*model_override*/ None).await;
+        chat.thread_id = Some(ThreadId::new());
+        chat.bottom_pane
+            .set_composer_text("keep my draft".into(), Vec::new(), Vec::new());
+        chat.handle_key_event(KeyEvent::new(KeyCode::Char('e'), modifiers));
+        let popup = render_bottom_popup(&chat, /*width*/ 80);
+        assert!(popup.contains("Select Model"));
+        assert_eq!(chat.bottom_pane.composer_text(), "keep my draft");
+        chat.handle_key_event(KeyEvent::new(KeyCode::Esc, KeyModifiers::NONE));
+        assert_eq!(chat.bottom_pane.composer_text(), "keep my draft");
+    }
+}
+
+#[tokio::test]
+async fn effort_cycle_accepts_terminal_encodings_and_preserves_draft_and_model() {
+    for key in [
+        KeyEvent::new(
+            KeyCode::Char('e'),
+            KeyModifiers::SUPER | KeyModifiers::SHIFT,
+        ),
+        KeyEvent::new(
+            KeyCode::Char('E'),
+            KeyModifiers::SUPER | KeyModifiers::SHIFT,
+        ),
+        KeyEvent::new(KeyCode::Char('e'), KeyModifiers::ALT | KeyModifiers::SHIFT),
+        KeyEvent::new(KeyCode::Char('E'), KeyModifiers::ALT | KeyModifiers::SHIFT),
+        KeyEvent::new(KeyCode::Char('E'), KeyModifiers::ALT),
+    ] {
+        let (mut chat, mut rx, _ops) = make_chatwidget_manual(Some("gpt-5.4")).await;
+        chat.thread_id = Some(ThreadId::new());
+        chat.set_reasoning_effort(Some(ReasoningEffortConfig::Medium));
+        chat.bottom_pane
+            .set_composer_text("keep my draft".into(), Vec::new(), Vec::new());
+        chat.handle_key_event(key);
+        let updates = std::iter::from_fn(|| rx.try_recv().ok())
+            .filter_map(|event| match event {
+                AppEvent::UpdateReasoningEffort(effort) => Some(effort),
+                AppEvent::UpdateModel(_) | AppEvent::PersistModelSelection { .. } => {
+                    panic!("cycling must not switch or persist the model")
+                }
+                _ => None,
+            })
+            .collect::<Vec<_>>();
+        assert_eq!(updates, vec![Some(ReasoningEffortConfig::High)]);
+        assert_eq!(chat.bottom_pane.composer_text(), "keep my draft");
+        assert_eq!(chat.current_model(), "gpt-5.4");
+        assert!(chat.bottom_pane.no_modal_or_popup_active());
+    }
+}
+
+#[tokio::test]
+async fn effort_cycle_visits_supported_advanced_levels_then_wraps() {
+    let (mut chat, mut rx, _ops) = make_chatwidget_manual(Some("gpt-5.4")).await;
+    chat.thread_id = Some(ThreadId::new());
+    let mut preset = get_available_model(&chat, "gpt-5.4");
+    let efforts = vec![
+        ReasoningEffortConfig::Low,
+        ReasoningEffortConfig::High,
+        ReasoningEffortConfig::XHigh,
+        ReasoningEffortConfig::Max,
+        ReasoningEffortConfig::Ultra,
+    ];
+    preset.supported_reasoning_efforts = efforts
+        .iter()
+        .map(|effort| ReasoningEffortPreset {
+            effort: effort.clone(),
+            description: "test level".to_string(),
+        })
+        .collect();
+    chat.model_catalog = std::sync::Arc::new(ModelCatalog::new(vec![preset]));
+    for (index, current) in efforts.iter().enumerate() {
+        chat.set_reasoning_effort(Some(current.clone()));
+        chat.handle_key_event(KeyEvent::new(KeyCode::Char('E'), KeyModifiers::ALT));
+        let updates = std::iter::from_fn(|| rx.try_recv().ok())
+            .filter_map(|event| match event {
+                AppEvent::UpdateReasoningEffort(effort) => Some(effort),
+                _ => None,
+            })
+            .collect::<Vec<_>>();
+        assert_eq!(
+            updates,
+            vec![Some(efforts[(index + 1) % efforts.len()].clone())]
+        );
+    }
+}
+
+#[tokio::test]
+async fn effort_cycle_leaves_open_picker_in_control() {
+    let (mut chat, mut rx, _ops) = make_chatwidget_manual(Some("gpt-5.4")).await;
+    chat.thread_id = Some(ThreadId::new());
+    chat.open_model_popup();
+    chat.handle_key_event(KeyEvent::new(KeyCode::Char('E'), KeyModifiers::ALT));
+    assert!(
+        std::iter::from_fn(|| rx.try_recv().ok()).all(|event| !matches!(
+            event,
+            AppEvent::UpdateReasoningEffort(_) | AppEvent::UpdatePlanModeReasoningEffort(_)
+        ))
+    );
+}
+
+#[tokio::test]
+async fn effort_cycle_does_nothing_without_multiple_supported_levels() {
+    for count in [0, 1] {
+        let (mut chat, mut rx, _ops) = make_chatwidget_manual(Some("gpt-5.4")).await;
+        chat.thread_id = Some(ThreadId::new());
+        let mut preset = get_available_model(&chat, "gpt-5.4");
+        preset.supported_reasoning_efforts.truncate(count);
+        chat.model_catalog = std::sync::Arc::new(ModelCatalog::new(vec![preset]));
+        chat.handle_key_event(KeyEvent::new(KeyCode::Char('E'), KeyModifiers::ALT));
+        assert!(
+            std::iter::from_fn(|| rx.try_recv().ok()).all(|event| !matches!(
+                event,
+                AppEvent::UpdateReasoningEffort(_) | AppEvent::UpdatePlanModeReasoningEffort(_)
+            ))
+        );
+    }
+}
+
+#[tokio::test]
+async fn effort_cycle_updates_only_plan_override_in_plan_mode() {
+    let (mut chat, mut rx, _ops) = make_chatwidget_manual(Some("gpt-5.4")).await;
+    chat.thread_id = Some(ThreadId::new());
+    chat.set_feature_enabled(Feature::CollaborationModes, /*enabled*/ true);
+    let mask = collaboration_modes::plan_mask(chat.model_catalog.as_ref()).expect("plan mode");
+    chat.set_collaboration_mask(mask);
+    let _ = drain_insert_history(&mut rx);
+    chat.handle_key_event(KeyEvent::new(KeyCode::Char('E'), KeyModifiers::ALT));
+    let updates = std::iter::from_fn(|| rx.try_recv().ok())
+        .filter_map(|event| match event {
+            AppEvent::UpdatePlanModeReasoningEffort(effort) => Some(effort),
+            AppEvent::UpdateReasoningEffort(_)
+            | AppEvent::PersistModelSelection { .. }
+            | AppEvent::OpenPlanReasoningScopePrompt { .. } => panic!("must update only Plan"),
+            _ => None,
+        })
+        .collect::<Vec<_>>();
+    assert_eq!(updates.len(), 1);
+    assert!(chat.bottom_pane.no_modal_or_popup_active());
+}
