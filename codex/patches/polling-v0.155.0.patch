+#[test_case::test_case(false, 300_000, true; "pipe waits for exit")]
+#[test_case::test_case(true, 300_000, false; "pty stays responsive")]
+#[test_case::test_case(false, 5_000, false; "configured cap is preserved")]
+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn unified_exec_background_poll_waits_without_model_wakeups(
+    tty: bool,
+    background_timeout: u64,
+    completes: bool,
+) -> Result<()> {
+    skip_if_target_windows!(Ok(()), "uses a POSIX-only command fixture");
+    skip_if_no_network!(Ok(()));
+    skip_if_sandbox!(Ok(()));
+
+    let builder = test_codex().with_config(move |config| {
+        config.background_terminal_max_timeout = background_timeout;
+    });
+    let harness = TestCodexHarness::with_auto_env_builder(builder).await?;
+    let responses = [
+        (
+            "start",
+            "exec_command",
+            json!({
+                "cmd": "printf progress; sleep 8; printf finished; exit 7",
+                "tty": tty,
+                "yield_time_ms": 250,
+            }),
+        ),
+        (
+            "poll",
+            "write_stdin",
+            json!({"session_id": 1000, "yield_time_ms": 1}),
+        ),
+    ]
+    .into_iter()
+    .map(|(id, tool, args)| {
+        sse(vec![
+            ev_response_created(id),
+            ev_function_call(id, tool, &args.to_string()),
+            ev_completed(id),
+        ])
+    })
+    .chain([sse(vec![ev_completed("done")])])
+    .collect();
+    let requests = mount_sse_sequence(harness.server(), responses).await;
+
+    harness.submit("wait for the background command").await?;
+
+    let start = parse_unified_exec_output(&harness.function_call_stdout("start").await)?;
+    let poll = parse_unified_exec_output(&harness.function_call_stdout("poll").await)?;
+    assert!(start.process_id.is_some());
+    assert!(start.output.contains("progress"));
+    assert_eq!(requests.requests().len(), 3);
+    assert_eq!(
+        (poll.exit_code, poll.process_id.is_none()),
+        (if completes { Some(7) } else { None }, completes)
+    );
+    assert_eq!(poll.output.contains("finished"), completes);
+    // Both exit and the interactive/configured deadlines return well before
+    // the new 60-second floor. A timeout is never reported as completion.
+    assert!(poll.wall_time_seconds < 20.0);
+    Ok(())
+}
