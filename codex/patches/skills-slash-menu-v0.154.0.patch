@@ -0,0 +1,121 @@
+//! Skill entries in the slash menu, resolved into native, path-bound mentions.
+
+use std::collections::HashSet;
+use std::str::FromStr;
+
+use codex_app_server_protocol::SkillMetadata;
+
+use super::ChatComposer;
+use super::draft_state::ComposerMentionBinding;
+use crate::bottom_pane::prompt_args::parse_slash_name;
+use crate::bottom_pane::slash_commands::ServiceTierCommand;
+use crate::skills_helpers::skill_description;
+use crate::slash_command::SlashCommand;
+
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub(crate) struct SkillCommand {
+    pub(crate) name: String,
+    pub(crate) skill_name: String,
+    pub(crate) description: String,
+    pub(crate) path: String,
+}
+
+pub(crate) fn skill_commands(
+    skills: &[SkillMetadata],
+    service_tiers: &[ServiceTierCommand],
+) -> Vec<SkillCommand> {
+    let mut seen = HashSet::new();
+    let mut commands = Vec::new();
+    // Reserve real skill names before assigning collision aliases.
+    let mut reserved: HashSet<String> = skills.iter().map(|skill| skill.name.clone()).collect();
+    reserved.extend(service_tiers.iter().map(|tier| tier.name.clone()));
+    for skill in skills.iter().filter(|skill| skill.enabled) {
+        if !seen.insert(&skill.name) {
+            continue;
+        }
+        let mut name = skill.name.clone();
+        if SlashCommand::from_str(&name).is_ok()
+            || service_tiers.iter().any(|tier| tier.name == name)
+            || name
+                .strip_prefix('g')
+                .and_then(|rest| rest.strip_suffix("al"))
+                .is_some_and(|middle| !middle.is_empty() && middle.bytes().all(|byte| byte == b'o'))
+        {
+            loop {
+                name = format!("skill:{name}");
+                if reserved.insert(name.clone()) {
+                    break;
+                }
+            }
+        }
+        commands.push(SkillCommand {
+            name,
+            skill_name: skill.name.clone(),
+            description: skill_description(skill).to_string(),
+            path: skill.path.display().to_string(),
+        });
+    }
+    commands.sort_by(|left, right| left.name.cmp(&right.name));
+    commands
+}
+
+impl ChatComposer {
+    pub(super) fn complete_slash_skill(&mut self, skill: &SkillCommand) {
+        let text = self.draft.textarea.text();
+        let token_end = text.find(char::is_whitespace).unwrap_or(text.len());
+        let needs_separator = token_end == text.len();
+        // Preserve the argument bytes and elements exactly, including their whitespace.
+        // The native mention codec accepts bare names, not plugin namespace colons.
+        // Keep the catalog name in the menu and bind the short mention to the exact path.
+        let mention_name = skill
+            .skill_name
+            .rsplit(':')
+            .next()
+            .unwrap_or(&skill.skill_name);
+        let mention = format!("${mention_name}");
+        self.draft.textarea.replace_range(0..token_end, "");
+        self.draft.textarea.set_cursor(/*pos*/ 0);
+        let id = self.draft.textarea.insert_element(&mention);
+        self.draft.mention_bindings.insert(
+            id,
+            ComposerMentionBinding {
+                sigil: '$',
+                mention: mention_name.to_string(),
+                path: skill.path.clone(),
+            },
+        );
+        if needs_separator {
+            self.draft.textarea.insert_str(" ");
+        }
+        self.draft
+            .textarea
+            .set_cursor(self.draft.textarea.text().len());
+        self.dismiss_completed_prefixed_token('$', 0..mention.len(), &mention);
+    }
+
+    pub(super) fn expand_typed_slash_skill(&mut self) {
+        if !self.slash_commands_enabled() || self.draft.is_bash_mode {
+            return;
+        }
+        let text = self.draft.textarea.text();
+        if !text.starts_with('/') {
+            return;
+        }
+        let Some((name, _, _)) = parse_slash_name(text) else {
+            return;
+        };
+        if let Some(skill) = skill_commands(
+            self.skills.as_deref().unwrap_or_default(),
+            &self.service_tier_commands,
+        )
+        .into_iter()
+        .find(|skill| skill.name == name)
+        {
+            self.complete_slash_skill(&skill);
+        }
+    }
+}
+
