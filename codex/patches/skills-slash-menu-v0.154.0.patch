+use super::*;
+use crate::app_event::AppEvent;
+use crate::bottom_pane::AppEventSender;
+use crate::bottom_pane::MentionBinding;
+use crate::bottom_pane::chat_composer::ChatComposerConfig;
+use crate::bottom_pane::chat_composer::InputResult;
+use crate::bottom_pane::chat_composer::QueuedInputAction;
+use crate::bottom_pane::chat_composer::popup_state::ActivePopup;
+use crate::bottom_pane::command_popup::CommandItem;
+use crate::test_support::PathBufExt;
+use crate::test_support::test_path_buf;
+use crossterm::event::KeyCode;
+use crossterm::event::KeyEvent;
+use crossterm::event::KeyModifiers;
+use pretty_assertions::assert_eq;
+use ratatui::buffer::Buffer;
+use ratatui::layout::Rect;
+use ratatui::widgets::WidgetRef;
+use tokio::sync::mpsc::unbounded_channel;
+
+fn skill(name: &str) -> SkillMetadata {
+    SkillMetadata {
+        name: name.to_string(),
+        description: "Run the example skill".to_string(),
+        short_description: None,
+        interface: None,
+        dependencies: None,
+        path: test_path_buf(&format!("/tmp/{name}/SKILL.md")).abs(),
+        scope: crate::test_support::skill_scope_user(),
+        enabled: true,
+        plugin_id: None,
+    }
+}
+
+fn composer(text: &str) -> ChatComposer {
+    let (tx, _rx) = unbounded_channel::<AppEvent>();
+    let mut composer = ChatComposer::new(
+        /*has_input_focus*/ true,
+        AppEventSender::new(tx),
+        /*enhanced_keys_supported*/ false,
+        "Ask Codex".to_string(),
+        /*disable_paste_burst*/ true,
+    );
+    composer.set_skill_mentions(Some(vec![skill("example")]));
+    composer.set_text_content(text.to_string(), Vec::new(), Vec::new());
+    composer.draft.textarea.set_cursor(text.len());
+    composer.sync_popups();
+    composer
+}
+
+fn press(composer: &mut ChatComposer, code: KeyCode) -> InputResult {
+    composer
+        .handle_key_event(KeyEvent::new(code, KeyModifiers::NONE))
+        .0
+}
+
+fn binding(name: &str) -> MentionBinding {
+    MentionBinding {
+        sigil: '$',
+        mention: name.rsplit(':').next().unwrap_or(name).to_string(),
+        path: skill(name).path.display().to_string(),
+    }
+}
+
+#[test]
+fn slash_skill_popup_snapshot() {
+    let composer = composer("/exa");
+    let ActivePopup::Command(popup) = &composer.popups.active else {
+        panic!("expected slash menu");
+    };
+    let area = Rect::new(
+        /*x*/ 0,
+        /*y*/ 0,
+        /*width*/ 80,
+        popup.calculate_required_height(80),
+    );
+    let mut buffer = Buffer::empty(area);
+    popup.render_ref(area, &mut buffer);
+    insta::assert_snapshot!("slash_skill_popup", format!("{buffer:?}"));
+}
+
+#[test]
+fn slash_skill_tab_binds_path_and_preserves_arguments() {
+    let mut composer = composer("/exa arguments\nsecond line");
+    composer.draft.textarea.set_cursor(4);
+    composer.sync_popups();
+    assert_eq!(press(&mut composer, KeyCode::Tab), InputResult::None);
+    assert_eq!(composer.current_text(), "$example arguments\nsecond line");
+    assert_eq!(
+        composer.snapshot_mention_bindings(),
+        vec![binding("example")]
+    );
+    assert!(!composer.popup_active());
+}
+
+#[test]
+fn slash_skill_enter_submits_native_binding() {
+    let mut composer = composer("/exa");
+    let InputResult::Submitted {
+        text,
+        text_elements,
+    } = press(&mut composer, KeyCode::Enter)
+    else {
+        panic!("expected native submission");
+    };
+    assert_eq!(text, "$example");
+    assert_eq!(text_elements.len(), 1);
+    assert_eq!(text_elements[0].placeholder(&text), Some("$example"));
+    assert_eq!(
+        composer.take_recent_submission_mention_bindings(),
+        vec![binding("example")]
+    );
+}
+
+#[test]
+fn slash_skill_exact_command_with_arguments_queues_as_plain_input() {
+    let mut composer = composer("/example first\nsecond");
+    composer.is_task_running = true;
+    let InputResult::Queued { text, action, .. } = press(&mut composer, KeyCode::Tab) else {
+        panic!("expected queued skill");
+    };
+    assert_eq!(
+        (text, action),
+        (
+            "$example first\nsecond".to_string(),
+            QueuedInputAction::Plain
+        )
+    );
+    assert_eq!(
+        composer.take_recent_submission_mention_bindings(),
+        vec![binding("example")]
+    );
+}
+
+#[test]
+fn slash_skill_exact_command_after_dismissing_menu_submits() {
+    let mut composer = composer("/example");
+    press(&mut composer, KeyCode::Esc);
+    assert!(
+        matches!(press(&mut composer, KeyCode::Enter), InputResult::Submitted { text, .. } if text == "$example")
+    );
+    assert_eq!(
+        composer.take_recent_submission_mention_bindings(),
+        vec![binding("example")]
+    );
+}
+
+#[test]
+fn slash_skill_catalog_refreshes_open_menu() {
+    let mut composer = composer("/");
+    composer.set_skill_mentions(Some(vec![skill("new-skill")]));
+    composer.set_text_content("/new-s".to_string(), Vec::new(), Vec::new());
+    composer.sync_popups();
+    press(&mut composer, KeyCode::Tab);
+    assert_eq!(composer.current_text(), "$new-skill ");
+    composer.set_skill_mentions(Some(Vec::new()));
+    composer.set_text_content("/new-skill".to_string(), Vec::new(), Vec::new());
+    assert_eq!(press(&mut composer, KeyCode::Enter), InputResult::None);
+    assert_eq!(composer.current_text(), "/new-skill");
+}
+
+#[test]
+fn slash_skill_collisions_preserve_builtins_and_all_unique_skills() {
+    let mut composer = composer("/model");
+    composer.set_skill_mentions(Some(vec![skill("model"), skill("skill:model")]));
+    let ActivePopup::Command(popup) = &composer.popups.active else {
+        panic!("expected menu")
+    };
+    assert_eq!(
+        popup.selected_item(),
+        Some(CommandItem::Builtin(SlashCommand::Model))
+    );
+    composer.set_text_content(
+        "/skill:skill:model arguments".to_string(),
+        Vec::new(),
+        Vec::new(),
+    );
+    assert!(
+        matches!(press(&mut composer, KeyCode::Enter), InputResult::Submitted { text, .. } if text == "$model arguments")
+    );
+    assert_eq!(
+        composer.take_recent_submission_mention_bindings(),
+        vec![binding("model")]
+    );
+}
+
+#[test]
+fn slash_skill_catalog_excludes_disabled_and_deduplicates_names() {
+    let mut disabled = skill("disabled");
+    disabled.enabled = false;
+    let commands = skill_commands(
+        &[disabled, skill("plugin:example"), skill("plugin:example")],
+        &[],
+    );
+    assert_eq!(
+        commands
+            .iter()
+            .map(|command| command.name.as_str())
+            .collect::<Vec<_>>(),
+        vec!["plugin:example"]
+    );
+    let mut composer = composer("/plugin:example args");
+    composer.set_skill_mentions(Some(vec![skill("plugin:example")]));
+    assert!(
+        matches!(press(&mut composer, KeyCode::Enter), InputResult::Submitted { text, .. } if text == "$example args")
+    );
+    assert_eq!(
+        composer.take_recent_submission_mention_bindings(),
+        vec![binding("plugin:example")]
+    );
+}
+
+#[test]
+fn slash_skill_plain_text_and_leading_space_remain_literal() {
+    for text in [" /example", "/example"] {
+        let mut composer = composer(text);
+        if text.starts_with('/') {
+            composer.config = ChatComposerConfig::plain_text();
+            composer.sync_popups();
+        }
+        assert!(
+            matches!(press(&mut composer, KeyCode::Enter), InputResult::Submitted { text, .. } if text == "/example")
+        );
+        assert_eq!(
+            composer.take_recent_submission_mention_bindings(),
+            Vec::new()
+        );
+    }
+}
+
+#[test]
+fn slash_skill_parent_owned_input_is_blocked() {
+    let mut composer = composer("/exa");
+    composer.blocks_direct_input = true;
+    assert_eq!(
+        press(&mut composer, KeyCode::Enter),
+        InputResult::ParentOwnedInputBlocked
+    );
+    assert_eq!(composer.current_text(), "/exa");
+}
+
+#[test]
+fn slash_skill_completion_preserves_other_mentions_and_images() {
+    let mut composer = composer("/exa $other");
+    composer.set_text_content_with_mention_bindings(
+        "/exa $other".to_string(),
+        Vec::new(),
+        Vec::new(),
+        vec![binding("other")],
+    );
+    let image_path = test_path_buf("/tmp/slash-skill-image.png");
+    composer.attach_image(image_path.clone());
+    // Image attachment inserts its placeholder; replace the draft while retaining the image.
+    composer.set_text_content_with_mention_bindings(
+        "/exa $other [Image #1]".to_string(),
+        Vec::new(),
+        vec![image_path.clone()],
+        vec![binding("other")],
+    );
+    composer.draft.textarea.set_cursor(4);
+    composer.sync_popups();
+    press(&mut composer, KeyCode::Tab);
+    assert_eq!(
+        composer.snapshot_mention_bindings(),
+        vec![binding("example"), binding("other")]
+    );
+    assert_eq!(composer.attachments.local_image_paths(), vec![image_path]);
+    assert_eq!(composer.current_text(), "$example $other [Image #1]");
+}
