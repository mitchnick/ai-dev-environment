#!/bin/bash
# herdr-app-icon [--if-missing | --install-agent] [Herdr.app]: set the horn as Herdr.app's Finder icon (Dock,
# Finder, Cmd+Tab). The horn is workspace-chrome-plus's herdr-horn.svg, which also draws the
# sidebar logo. Default app: /Applications/Herdr.app, else ~/Applications/Herdr.app.
# A Herdr update replaces the bundle and drops the custom icon. --install-agent installs
# a per-user launchd check at login and every minute, independent of the app UI.
# It writes only Finder's custom-icon data; Contents/ and the signature are untouched.
# Needs rsvg-convert (brew install librsvg); iconutil and swift come with macOS and the
# Command Line Tools.
set -euo pipefail
# GUI apps and launchd do not inherit the interactive shell's Homebrew PATH.
export PATH="/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"

if [ "${1:-}" = "--install-agent" ]; then
	shift
	# Generate escaped plist values rather than interpolating paths into XML.
	python3 - "$0" "${1:-}" <<'PYTHON'
import os, pathlib, plistlib, sys
home = pathlib.Path.home()
logs = home / "Library/Logs/herdr-app-icon"
logs.mkdir(parents=True, exist_ok=True)
plist = home / "Library/LaunchAgents/local.herdr-app-icon.plist"
plist.parent.mkdir(parents=True, exist_ok=True)
args = [os.path.abspath(sys.argv[1]), "--if-missing"]
if sys.argv[2]:
    args.append(os.path.abspath(sys.argv[2]))
job = dict(Label="local.herdr-app-icon", ProgramArguments=args,
           RunAtLoad=True, StartInterval=60,
           StandardOutPath=str(logs / "stdout.log"),
           StandardErrorPath=str(logs / "stderr.log"))
if os.environ.get("HERDR_APP_HOME"):
    job["EnvironmentVariables"] = {"HERDR_APP_HOME": os.environ["HERDR_APP_HOME"]}
plist.write_bytes(plistlib.dumps(job))
PYTHON
	job="$HOME/Library/LaunchAgents/local.herdr-app-icon.plist"
	launchctl bootout "gui/$(id -u)/local.herdr-app-icon" 2>/dev/null || true
	launchctl bootstrap "gui/$(id -u)" "$job"
	echo "Installed icon repair: login and every 60 seconds. Logs: ~/Library/Logs/herdr-app-icon/"
	exit 0
fi

svg="${HERDR_APP_HOME:-$HOME/.config/herdr-app}/mods/workspace-chrome-plus/herdr-horn.svg"
if_missing=false
if [ "${1:-}" = "--if-missing" ]; then if_missing=true; shift; fi
app="${1:-}"
if [ -z "$app" ]; then
	for candidate in /Applications/Herdr.app "$HOME/Applications/Herdr.app"; do
		[ -d "$candidate" ] && { app="$candidate"; break; }
	done
fi
[ -f "$svg" ] || { echo "herdr-app-icon: $svg is missing; install the workspace-chrome-plus mod" >&2; exit 1; }
[ -d "$app" ] || { echo "herdr-app-icon: Herdr.app not found; pass its path" >&2; exit 1; }
# Finder keeps a folder's custom icon in an "Icon\r" file inside it.
if $if_missing && [ -s "$app/Icon"$'\r'/..namedfork/rsrc ]; then
	finder_info="$(xattr -px com.apple.FinderInfo "$app" 2>/dev/null | tr -d '[:space:]' || true)"
	# Finder's kHasCustomIcon bit is 0x0400 in the flags at bytes 8–9.
	if [ "${#finder_info}" -ge 20 ] && (( (16#${finder_info:16:4} & 1024) != 0 )); then
		exit 0
	fi
fi
echo "$(date '+%F %T') herdr-app-icon: setting the horn on $app"
command -v rsvg-convert >/dev/null 2>&1 || { echo "herdr-app-icon: needs rsvg-convert (brew install librsvg)" >&2; exit 1; }

work="$(mktemp -d)"
trap 'rm -rf "$work"' EXIT
iconset="$work/herdr-horn.iconset"
mkdir "$iconset"
for size in 16 32 128 256 512; do
	rsvg-convert -w "$size" -h "$size" -o "$iconset/icon_${size}x${size}.png" "$svg"
	rsvg-convert -w "$((size * 2))" -h "$((size * 2))" -o "$iconset/icon_${size}x${size}@2x.png" "$svg"
done
iconutil -c icns "$iconset" -o "$work/herdr-horn.icns"

cat > "$work/set-icon.swift" <<'SWIFT'
import AppKit
let args = CommandLine.arguments
guard let icon = NSImage(contentsOfFile: args[1]) else { fatalError("cannot load \(args[1])") }
guard NSWorkspace.shared.setIcon(icon, forFile: args[2], options: []) else { fatalError("cannot set the icon on \(args[2])") }
print("Set the horn icon on \(args[2])")
SWIFT
swift "$work/set-icon.swift" "$work/herdr-horn.icns" "$app"
