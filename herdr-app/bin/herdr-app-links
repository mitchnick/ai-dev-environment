#!/usr/bin/env python3
"""herdr-app-links: the URLs an agent mentioned in one hc terminal, newest first, as JSON.

The data half of cmd+k (herdr-app's link-picker mod), ported from the openr plugin's
candidates.py (wraithyy/herdr-openr, MIT; local copy in
~/Projects/ai-dev-environment/herdr/extensions/custom/herdr-openr).

Like openr's links mode it reads the agent's own transcript, so URLs that Claude Code
hides behind Markdown link text still show, and leaves out user messages, reasoning and
tool output. Without a local transcript it falls back to the terminal's screen and
scrollback.

  claude  ~/.claude/sessions/<pid>.json names the session; its transcript lives in
          ~/.claude/projects/<cwd slug>/<session>.jsonl
  codex   the rollout .jsonl under ~/.codex/sessions that the process has open (lsof)

Usage: herdr-app-links --terminal t7 [--lines 1000] [--history 3000]
Prints {"source": "transcript"|"screen", "urls": [...]}.
"""

import argparse
import collections
import json
import os
from pathlib import Path
import re
import shutil
import subprocess
import sys

AGENTS = ("claude", "codex")
INTERPRETERS = ("node", "bun", "deno", "python", "python3")


def hc(*args):
	exe = shutil.which("hc") or str(Path.home() / ".local/bin/hc")
	return subprocess.run([exe, *args], check=True, capture_output=True, text=True, timeout=10).stdout


def agent_kind(argv):
	if not argv:
		return None
	first = Path(argv[0]).name
	if first in AGENTS:
		return first
	if first in INTERPRETERS and len(argv) > 1 and Path(argv[1]).name in AGENTS:
		return Path(argv[1]).name
	return None


def claude_transcript(pid):
	try:
		session = json.loads((Path.home() / ".claude/sessions" / f"{pid}.json").read_text())
	except (OSError, ValueError):
		return None
	sid = session.get("sessionId", "")
	if not re.fullmatch(r"[a-fA-F0-9-]{36}", sid):
		return None
	root = Path(os.environ.get("CLAUDE_CONFIG_DIR", str(Path.home() / ".claude"))) / "projects"
	exact = root / re.sub(r"[^a-zA-Z0-9-]", "-", session.get("cwd", "")) / f"{sid}.jsonl"
	if exact.is_file():
		return exact
	return next(root.glob(f"*/{sid}.jsonl"), None)


def codex_transcript(pid):
	root = Path(os.environ.get("CODEX_HOME", str(Path.home() / ".codex"))).resolve()
	try:
		out = subprocess.run(["/usr/sbin/lsof", "-p", str(pid), "-Fn"], capture_output=True, text=True, timeout=5).stdout
	except (OSError, subprocess.SubprocessError):
		return None
	for line in out.splitlines():
		if line.startswith("n") and line.endswith(".jsonl"):
			path = Path(line[1:])
			if root in path.resolve().parents:
				return path
	return None


def messages(path, limit=1000):
	"""Assistant text only, from the last `limit` records (openr's messages())."""
	with path.open() as stream:
		rows = collections.deque(stream, maxlen=limit)
	for row in rows:
		try:
			record = json.loads(row)
		except ValueError:  # a running agent may be halfway through a write
			continue
		if record.get("type") == "response_item":
			message = record.get("payload", {})
			if message.get("type") != "message":
				continue
		elif record.get("type") == "assistant":
			message = record.get("message", {})
		else:
			continue
		if message.get("role") != "assistant":
			continue
		for part in message.get("content", []) or []:
			if isinstance(part, dict) and part.get("type") in ("text", "output_text"):
				yield part.get("text", "")


def urls(text):
	# Balanced parentheses are legal URL characters; strip only unmatched closers.
	for match in re.finditer(r'https?://[^\s<>"`\x00-\x1f]+', text):
		url = match.group().rstrip(".,;:!?")
		while url and (url[-1] == "'" or any(
			url.endswith(close) and url.count(close) > url.count(opening)
			for opening, close in [("(", ")"), ("[", "]"), ("{", "}")]
		)):
			url = url[:-1]
		if url:
			yield url


def newest_first(texts):
	seen, out = set(), []
	for text in reversed(list(texts)):
		for url in reversed(list(urls(text))):
			if url not in seen:
				seen.add(url)
				out.append(url)
	return out


def main():
	parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
	parser.add_argument("--terminal", required=True)
	parser.add_argument("--lines", type=int, default=1000, help="transcript records to read")
	parser.add_argument("--history", type=int, default=3000, help="scrollback lines when there's no transcript")
	args = parser.parse_args()
	info = json.loads(hc("get", args.terminal, "--json"))
	fg = info.get("foreground") or {}
	kind, pid = agent_kind(fg.get("argv") or []), fg.get("pid")
	path = None
	if pid and "/" not in args.terminal:  # transcripts are only read on this machine
		path = claude_transcript(pid) if kind == "claude" else codex_transcript(pid) if kind == "codex" else None
	if path:
		result = {"source": "transcript", "urls": newest_first(messages(path, args.lines))}
	else:
		# Screen lines rejoin wrapped URLs poorly, so read the text as one block.
		text = hc("read", args.terminal, "--lines", str(args.history))
		result = {"source": "screen", "urls": newest_first(text.splitlines())}
	print(json.dumps(result))


if __name__ == "__main__":
	try:
		main()
	except (OSError, ValueError, subprocess.SubprocessError) as error:
		print(f"herdr-app-links: {error}", file=sys.stderr)
		sys.exit(1)
