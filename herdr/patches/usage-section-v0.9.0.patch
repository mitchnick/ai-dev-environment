+/// Usage rows carry only reported tokens, so every built-in space token resolves to
+/// nothing here. Rows whose tokens are all absent collapse, exactly as space rows do.
+pub(crate) fn usage_rows(
+    config: &UsageSidebarConfig,
+    tokens: &std::collections::HashMap<String, String>,
+) -> Vec<Vec<ResolvedToken>> {
+    config
+        .rows
+        .iter()
+        .filter_map(|row| {
+            let resolved = row
+                .iter()
+                .filter_map(|configured| {
+                    let (token, style) = configured.parts();
+                    let kind = match token {
+                        SpaceSidebarToken::Custom(name) => {
+                            tokens.get(name).cloned().map(ResolvedTokenKind::Custom)
+                        }
+                        _ => None,
+                    }?;
+                    let style = kind
+                        .text_value()
+                        .map_or(style, |value| configured.style_for_value(value));
