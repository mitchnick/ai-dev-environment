+#[test]
+fn usage_section_renders_once_from_local_tokens_and_collapses_on_click() {
+    use crate::config::SpaceSidebarToken;
+
+    let mut config = Config::default();
+    config.ui.sidebar.usage.rows = vec![vec![
+        SpaceSidebarToken::Custom("ul5".into()),
+        SpaceSidebarToken::Custom("u5lo".into()),
+    ]];
+    let mut state = ClientShellState::new(ClientShellConfig::from_config(&config));
+    let profile = remote_profile();
+    let endpoint_id = ClientEndpointId::Ssh(profile.id.clone());
+    state.set_endpoint_catalog(&[profile]);
+    state.set_endpoint_status(&endpoint_id, ClientEndpointStatus::Online);
+
+    let mut local = snapshot();
+    local.workspaces[0].tokens = vec![("ul5".into(), "5h".into()), ("u5lo".into(), "27%".into())];
+    state.set_snapshot(Box::new(local));
+    state.set_pane_surface(surface());
+    let mut remote = snapshot();
+    remote.boot_id = "remote-boot".into();
+    remote.workspaces[0].tokens = vec![("ul5".into(), "5h".into()), ("u5lo".into(), "99%".into())];
+    state.set_endpoint_snapshot(&endpoint_id, Box::new(remote));
+
+    let frame_text = |state: &mut ClientShellState| {
+        let frame = state.compose(100, 28).expect("combined endpoint frame");
+        frame
+            .cells
+            .chunks(frame.width as usize)
+            .map(|row| {
+                row.iter()
+                    .map(|cell| cell.symbol.as_str())
+                    .collect::<String>()
+            })
+            .collect::<Vec<_>>()
+            .join("\n")
+    };
+
+    let text = frame_text(&mut state);
+    assert_eq!(text.matches("▾ usage").count(), 1, "frame: {text}");
+    assert!(text.contains("5h · 27%"), "frame: {text}");
+    assert!(!text.contains("99%"), "frame: {text}");
+
+    let toggle = state.hits.usage_toggle;
+    assert!(!toggle.is_empty());
+    let last_workspace_bottom = state
+        .hits
+        .workspaces
+        .iter()
+        .map(|hit| hit.rect.bottom())
+        .max()
+        .expect("workspace rows");
+    assert_eq!(
+        toggle.y, last_workspace_bottom,
+        "usage header should sit directly under the last workspace row"
+    );
+    state.handle_raw_events(vec![RawInputEvent::Mouse(MouseEvent {
+        kind: MouseEventKind::Down(MouseButton::Left),
+        column: toggle.x,
+        row: toggle.y,
+        modifiers: KeyModifiers::empty(),
+    })]);
+    assert!(state.usage_collapsed);
+    let text = frame_text(&mut state);
+    assert_eq!(text.matches("▸ usage").count(), 1, "frame: {text}");
+    assert!(!text.contains("27%"), "frame: {text}");
+}
diff --git a/src/client/shell/usage_sidebar.rs b/src/client/shell/usage_sidebar.rs
new file mode 100644
index 0000000..9621639
--- /dev/null
+++ b/src/client/shell/usage_sidebar.rs
@@ -0,0 +1,116 @@
+//! One pinned usage block at the foot of the spaces list.
+//!
+//! Account-wide usage is reported as workspace metadata tokens, so without this it
+//! renders under whichever workspace received it — once per machine in the endpoint
+//! sidebar. The block reads the local machine's tokens only, collapses like a machine
+//! header, and stays put while the workspace list scrolls.
+
+use super::render::put_text;
+use super::*;
+use ratatui::{
+    text::Line,
+    widgets::{Paragraph, Widget},
+};
+
+/// Every usage token the local machine currently reports. `herdr-usage` pins its
+/// tokens to one workspace and clears the rest, so the union is that one block.
+pub(super) fn local_tokens(snapshot: Option<&ClientShellSnapshot>) -> HashMap<String, String> {
+    let mut tokens = HashMap::new();
+    let Some(snapshot) = snapshot else {
+        return tokens;
+    };
+    for workspace in &snapshot.workspaces {
+        for (name, value) in &workspace.tokens {
+            tokens.insert(name.clone(), value.clone());
+        }
+    }
+    tokens
+}
+
+pub(super) fn rows(
+    config: &ClientShellConfig,
+    snapshot: Option<&ClientShellSnapshot>,
+) -> Vec<Vec<crate::ui::ResolvedToken>> {
+    if config.usage.rows.is_empty() {
+        return Vec::new();
+    }
+    crate::ui::sidebar_usage_rows(&config.usage, &local_tokens(snapshot))
+}
+
+/// Header row plus the token rows when expanded, never more than half the section so
+/// a long usage layout cannot squeeze the workspace list out of the sidebar.
+pub(super) fn block_height(
+    rows: &[Vec<crate::ui::ResolvedToken>],
+    collapsed: bool,
+    available: u16,
+) -> u16 {
+    if rows.is_empty() || available < 2 {
+        return 0;
+    }
+    let body = if collapsed {
+        0
+    } else {
+        u16::try_from(rows.len()).unwrap_or(u16::MAX)
+    };
+    body.saturating_add(1).min(available / 2)
+}
+
+pub(super) fn render(
+    buffer: &mut Buffer,
+    area: Rect,
+    rows: &[Vec<crate::ui::ResolvedToken>],
+    collapsed: bool,
+    config: &ClientShellConfig,
+    hits: &mut ShellHitMap,
+) {
+    if area.height == 0 || area.width == 0 {
+        return;
+    }
+    let palette = &config.palette;
+    let header = Rect::new(area.x, area.y, area.width, 1);
+    buffer.set_style(header, Style::default().bg(palette.surface1));
+    let marker = if collapsed { "▸" } else { "▾" };
+    put_text(
+        buffer,
+        header.x,
+        header.y,
+        header.width,
+        &format!("{marker} {}", config.usage.label),
+        Style::default()
+            .fg(palette.subtext0)
+            .add_modifier(Modifier::BOLD),
+    );
+    put_text(
+        buffer,
+        header.x,
+        header.y,
+        header.width.min(1),
+        marker,
+        Style::default().fg(palette.overlay1),
+    );
+    hits.usage_toggle = header;
+    if collapsed {
+        return;
+    }
+    let content_width = area.width.saturating_sub(2);
+    for (index, row) in rows.iter().enumerate() {
+        let y = area.y.saturating_add(1).saturating_add(index as u16);
+        if y >= area.bottom() {
+            break;
+        }
+        let spans = crate::ui::resolved_token_spans(
+            row,
+            ("", Style::default()),
+            Style::default().fg(palette.overlay0),
+            Style::default().fg(palette.subtext0),
+            Style::default().fg(palette.overlay0),
+            Style::default().fg(palette.overlay1),
+            palette,
+            content_width.saturating_sub(1) as usize,
+        );
+        Paragraph::new(Line::from(spans)).render(
+            Rect::new(area.x.saturating_add(1), y, content_width, 1),
+            buffer,
+        );
+    }
+}
